# AI Trading System Configuration Template
# Copy this file to .env and fill in your actual values

# ===== REQUIRED: UPSTOX API CREDENTIALS =====
# Get these from your Upstox developer account
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here

# ===== OPTIONAL: AI API KEYS =====
# Choose at least one for enhanced AI features

# Google Gemini API (Recommended)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI (Alternative to Gemini)
# Get from: Azure portal -> OpenAI service
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here

# ===== TRADING PARAMETERS =====
# Maximum risk per trade (0.005 = 0.5% of portfolio)
MAX_RISK_PER_TRADE=0.005

# Daily loss cap (0.03 = 3% of portfolio)
DAILY_LOSS_CAP=0.03

# Maximum number of trades per day
MAX_TRADES_PER_DAY=200

# Minimum profit target per trade (0.002 = 0.2%)
MIN_PROFIT_TARGET=0.002

# ===== RISK MANAGEMENT =====
# Stop loss types to use
STOP_LOSS_LEVELS=fixed,adaptive,trailing

# Maximum slippage tolerance (0.001 = 0.1%)
SLIPPAGE_TOLERANCE=0.001

# ===== STRATEGY CONFIGURATION =====
# Technical indicators to use
TECHNICAL_INDICATORS=rsi,macd,bollinger,ma,atr

# ML models to train and use
ML_MODELS=lightgbm,xgboost,lstm

# Signal confidence threshold (0.7 = 70%)
STRATEGY_CONFIDENCE_THRESHOLD=0.7

# Require consensus among multiple signals
REQUIRE_CONSENSUS=True

# ===== DATA SOURCES =====
# Market data sources (upstox is primary)
MARKET_DATA_SOURCES=upstox,finnhub,alpha_vantage

# Data update interval in seconds
TICK_INTERVAL=1

# ===== MODEL TRAINING =====
# How often to retrain models (86400 = daily)
MODEL_UPDATE_INTERVAL=86400

# ===== EXECUTION SETTINGS =====
# Default order type
DEFAULT_ORDER_TYPE=limit

# ===== MONITORING =====
# Dashboard port
DASHBOARD_PORT=8000

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=60

# Alert channels (comma-separated)
ALERT_CHANNELS=telegram,slack,email

# ===== OPTIONAL: ADDITIONAL DATA SOURCES =====
# Finnhub API key (for additional market data)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage API key (for additional market data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ===== NOTES =====
# 1. Remove the "_here" suffix and replace with your actual values
# 2. Keep the quotes if your keys contain special characters
# 3. Never share this file - it contains your API keys
# 4. Back up this file securely after configuration